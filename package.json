{
  "name": "agoramesh",
  "version": "0.36.0",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "npm audit --audit-level=moderate",
    "security:headers": "node scripts/check-security-headers.mjs",
    "release:artifacts": "npm run build && node scripts/release-artifacts.mjs generate",
    "release:check": "node scripts/release-artifacts.mjs check",
    "release:rc-check": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit && npm run security:headers && npm run release:artifacts && npm run release:check"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^5.0.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.511.0",
    "nostr-tools": "^2.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
